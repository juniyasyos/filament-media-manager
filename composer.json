{
    "name": "juniyasyos/filament-media-manager",
    "type": "library",
    "description": "Manage your media files using spatie media library with easy to use GUI for FilamentPHP",
    "keywords": [
        "php",
        "laravel",
        "filament",
        "media",
        "manager",
        "spatie",
        "media-library"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Juniyasyos\\FilamentMediaManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juniyasyos\\FilamentMediaManager\\FilamentMediaManagerServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy x Ahmad Ilyas",
            "email": "ahmadilyasdahlan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "tomatophp/console-helpers": "^1.1",
        "tomatophp/filament-icons": "^v1.1",
        "spatie/laravel-medialibrary": "^11.0",
        "bezhansalleh/filament-shield": "^3.3",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "nwidart/laravel-modules": "^12.0",
        "filament/filament": "^3.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}